# Ignore everything except empty data/, scripts/, figures/, and results/
/*

!/.gitignore
!/.Rprofile
!/DESCRIPTION
!/renv.lock
!/renv/
/renv/*
!/renv/activate.R
!/renv/settings.json
!/renv/.gitignore

!/data/
/data/*
!/data/.gitkeep

!/scripts/
!/scripts/**

# Keep preprocessing scripts local
/scripts/00_*

!/figures/
!/figures/**

!/results/
!/results/**

# Keep session junk out of tracked trees
**/.Rhistory
**/.RData
**/.DS_Store
**/.Rproj.user/